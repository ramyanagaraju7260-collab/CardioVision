# ============================================================
# CardioVision AI — Environment Configuration
# ============================================================

# Application Mode: "demo" or "production"
# demo    = simulated predictions with visible badge
# production = real ML model inference
APP_MODE=demo

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./cardiovision.db

# Frontend (Vite uses VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000

# Model Configuration
MODEL_THRESHOLD=0.50
MODEL_VERSION=1.0.0

# File Upload
MAX_UPLOAD_SIZE_MB=16
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# Security
SECRET_KEY=change-this-to-a-secure-random-string
